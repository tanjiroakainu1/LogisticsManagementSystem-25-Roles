# Local development — copy to .env
OPENROUTER_API_KEY=your_secret_key_here
OPENROUTER_MODEL=qwen/qwen-2.5-7b-instruct

# ─── Vercel deployment ───
# 1. Push this repo to GitHub and import in Vercel
# 2. Project Settings → Environment Variables → add:
#      OPENROUTER_API_KEY  =  (your OpenRouter key)
#      OPENROUTER_MODEL    =  qwen/qwen-2.5-7b-instruct  (optional)
# 3. Deploy — SPA routing + /api/chat/completions are configured in vercel.json
# 4. LMS Intelligence chatbot calls /api/chat/completions (serverless, key stays private)
